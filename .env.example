PORT=3000

# MySQL (Railway) — copie os valores do painel Railway > Variables
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

JWT_SECRET=replace_with_a_secure_random_value

# Endereço do painel (usado no CORS e no link de redefinição de senha)
SPA_ORIGIN=https://dashfood-rose.vercel.app

# Anthropic (Claude Haiku) — chatbot no modo IA
ANTHROPIC_API_KEY=sk-ant-...

# E-mail transacional (Resend) — recuperação de senha
# Brevo (xkeysib-...) envia para qualquer e-mail sem domínio próprio; Resend (re_...) só para o dono da conta sem domínio
EMAIL_API_KEY=xkeysib-...
EMAIL_FROM=DashFood <seuemail@gmail.com>
